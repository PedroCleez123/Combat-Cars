  },
  "build": {
    "appId": "com.carsoccer.arsenal",
    "productName": "Combat Cars",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/**/*",
      "src/assets/vehicle/model.gltf",
      "src/assets/vehicle/geometry.bin",
      "assets/**/*",
      "node_modules/three/**/*",
      "node_modules/three/build/three.module.js",
      "server.mjs",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".rocketsim-bridge-build-r20/rocketsim_bridge-r20.exe",
        "to": "bridge/rocketsim_bridge-r20.exe"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "signExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
